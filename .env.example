# Salin menjadi .env lalu isi. JANGAN commit file .env.
# Tanda (wajib) = app menolak start kalau kosong.

# --- Server ---
# development | production (PM2 sudah set production)
NODE_ENV=production
# Di VPS pakai 127.0.0.1 supaya hanya bisa diakses lewat Nginx
HOST=127.0.0.1
PORT=3000

# --- Keamanan ---
# (wajib) Password login dashboard
ADMIN_PASSWORD=
# (wajib) Token API untuk header Authorization. Buat dengan: openssl rand -hex 24
API_TOKEN=
# Opsional: IP yang boleh memanggil /api/* (pisahkan koma). Kosong = semua IP.
IP_WHITELIST=

# --- Database (Supabase) ---
# (wajib) Supabase > Project Settings > Database > Connection string (URI).
# Disarankan "Session pooler" (port 5432) karena VPS long-running.
DATABASE_URL=
# true = pakai SSL (wajib untuk Supabase). false hanya untuk Postgres lokal tanpa SSL.
DATABASE_SSL=true

# --- WhatsApp ---
# Folder sesi login WhatsApp (di luar Git). Hapus = harus scan QR ulang.
AUTH_DIR=./storage/auth
# Opsional: URL penerima pesan masuk (POST JSON)
WEBHOOK_URL=
# Jeda acak antar pesan (detik)
DELAY_MIN=2
DELAY_MAX=5

# --- Log ---
# Level log Baileys: fatal | error | warn | info | debug
LOG_LEVEL=warn
